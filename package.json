{
  "name": "dsh-wechat-bridge",
  "version": "0.2.0",
  "ilink_appid": "bot",
  "description": "WeChat ⇄ DSH bridge bundle: iLink gateway + conversation node with dynamic agent-preset routing, image-in-session, and a Web settings panel",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "wechat",
    "weixin",
    "ilink",
    "agent-preset",
    "bridge"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kairos0922/dsh-wechat-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/Kairos0922/dsh-wechat-bridge/issues"
  },
  "homepage": "https://github.com/Kairos0922/dsh-wechat-bridge#readme",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "scripts/login.mjs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bundle": "tsdown && node scripts/wrap-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/*.test.ts\"",
    "login": "node scripts/login.mjs",
    "verify": "pnpm build && pnpm bundle && node --check lib/client.js && node --check lib/index.js && pnpm test",
    "prepublishOnly": "pnpm verify"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-credentials": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/dsh-user-approval": "0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-credentials-local": "0.1.0-rc.6",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.1",
    "react": "^18.3.1",
    "tsdown": "^0.15.8",
    "typescript": "^5.9.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "packageManager": "pnpm@10.34.5"
}
